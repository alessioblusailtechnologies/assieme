# Regole valide per tutto il repository.
# I singoli progetti hanno il proprio .gitignore per ciò che li riguarda:
# fe-angular/.gitignore, website/.gitignore

# Dipendenze
node_modules/

# Output di build e cache
dist/
.angular/
.astro/
out-tsc/
*.tsbuildinfo

# Log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Mockoon: eventuali log runtime della CLI
mockoon-logs/

# Editor e IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.history/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Segreti — nulla di questo deve mai entrare nel repository
.env
.env.*
!.env.example
*.pem
*.key

# Esperimento del motore agentico (ASSIEME-motore-agentico.md §8):
# i PDF del pilota e le loro conversioni contengono dati reali di clienti,
# restano locali. Tracciati solo README, CLAUDE.md e script.
esperimento-motore/originali/*
!esperimento-motore/originali/README.md
esperimento-motore/workspace/archivio-pubblico/
esperimento-motore/workspace/tenant/
esperimento-motore/risultati/

# Sorgenti video stock (Envato e simili) appoggiati nella root: pesano
# decine di MB e in repo va solo l'encodato di website/public/media/.
/*-utc.mp4

# Caratteri in prova sotto licenza commerciale.
# Le licenze trial (TypeType e simili) permettono di valutare il font sul
# proprio computer ma vietano di condividerlo: metterlo nel repository
# sarebbe distribuzione. Resta locale finché non si compra la licenza.
fe-angular/public/fonts/prova-locale/
TWKGhost/
