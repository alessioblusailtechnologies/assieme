# Regole valide per tutto il repository.
# I singoli progetti hanno il proprio .gitignore per ciò che li riguarda:
# fe-angular/.gitignore, website/.gitignore

# Dipendenze
node_modules/

# Output di build e cache
dist/
.angular/
.astro/
out-tsc/
*.tsbuildinfo

# Log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Mockoon: eventuali log runtime della CLI
mockoon-logs/

# Editor e IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.history/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Segreti — nulla di questo deve mai entrare nel repository
.env
.env.*
!.env.example
*.pem
*.key

# Caratteri in prova sotto licenza commerciale.
# Le licenze trial (TypeType e simili) permettono di valutare il font sul
# proprio computer ma vietano di condividerlo: metterlo nel repository
# sarebbe distribuzione. Resta locale finché non si compra la licenza.
fe-angular/public/fonts/prova-locale/
