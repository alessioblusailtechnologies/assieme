---
import AnnouncementBar from '~/components/AnnouncementBar.astro';
import Seo from '~/components/Seo.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import { site } from '~/config/site';
import { contenuti, LINGUA_PREDEFINITA, lingue, type Alternativa, type Lingua } from '~/i18n';
import '~/styles/global.css';

const { legalName } = site;

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  /** Barra annunci spenta ovunque in vista del lancio; si riaccende
      passando `announcement={true}` dalla singola pagina. */
  announcement?: boolean;
  lingua?: Lingua;
  /** Alternate hreflang per le rotte fuori tabella, come le guide. */
  alternative?: Alternativa[];
}

const {
  announcement = false,
  lingua = LINGUA_PREDEFINITA,
  ...seo
} = Astro.props;

const t = contenuti(lingua).comune;
---

<!doctype html>
<html lang={lingue[lingua].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1C1A15" />
    <meta name="author" content={legalName} />

    <!-- Google per il risultato di ricerca vuole una PNG o un .ico a multipli
         di 48px: l'SVG da solo non basta, e il .ico alla radice è il
         ripiego che il suo crawler prova comunque. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- I due tagli che compongono ogni schermata above the fold — il
         regular dei titoli e del corpo, il medio delle evidenze:
         precaricarli evita il salto tipografico al primo paint. -->
    <link
      rel="preload"
      href="/fonts/TWKGhost-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/TWKGhost-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <Seo {...seo} lingua={lingua} />
  </head>

  <body>
    <a class="skip-link" href="#contenuto">{t.vaiAlContenuto}</a>

    {announcement && <AnnouncementBar lingua={lingua} />}
    <SiteHeader lingua={lingua} />

    <main id="contenuto">
      <slot />
    </main>

    <SiteFooter lingua={lingua} />
  </body>
</html>
