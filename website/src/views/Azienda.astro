---
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Closing from '~/components/Closing.astro';
import PageHero from '~/components/PageHero.astro';
import { site } from '~/config/site';
import { contenuti, href, percorso, type Lingua } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';

export interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;
const t = contenuti(lingua).azienda;

const lead = t.testata.lead?.replace('{azienda}', site.legalName);
---

<BaseLayout lingua={lingua} title={t.meta.title} description={t.meta.description}>
  <PageHero
    eyebrow={t.testata.eyebrow}
    title={t.testata.title}
    lead={lead}
    video={{
      src: '/media/azienda-hero.mp4',
      poster: '/media/azienda-hero-poster.jpg',
    }}
  />

  <Breadcrumbs
    lingua={lingua}
    trail={[{ label: t.briciola, href: percorso('azienda', lingua) }]}
  />

  <section class="story" aria-labelledby="story-title">
    <div class="shell story__inner">
      <h2 class="serif story__title" id="story-title">{t.storia.title}</h2>
      <div class="story__body prose">
        {t.storia.paragrafi.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="values" aria-labelledby="values-title">
    <div class="shell">
      <h2 class="serif values__title" id="values-title">
        {t.criteri.title}
      </h2>
      <dl class="values__list">
        {
          t.criteri.voci.map((v) => (
            <div class="values__row">
              <dt class="values__term">{v.term}</dt>
              <dd class="values__detail">{v.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="jobs" id={t.lavoro.id} aria-labelledby="jobs-title">
    <div class="shell">
      <h2 class="serif jobs__title" id="jobs-title">{t.lavoro.title}</h2>
      <p class="lead jobs__lead">
        {t.lavoro.lead}
      </p>

      <ul class="jobs__list">
        {
          t.lavoro.posizioni.map((r) => (
            <li class="jobs__row">
              <h3 class="jobs__role">{r.title}</h3>
              <p class="jobs__detail">{r.detail}</p>
              <a
                class="btn btn--text"
                href={`mailto:${site.email}?subject=${encodeURIComponent(r.title)}`}
              >
                {t.lavoro.candidati}{' '}
                <span class="btn__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="jobs__note">
        {t.lavoro.notaPrima}<a href={`mailto:${site.email}`}>{site.email}</a>{t.lavoro.notaDopo}
      </p>
    </div>
  </section>

  <Closing
    title={t.chiusura.title}
    cta={t.chiusura.cta}
    href={href(t.chiusura.link, lingua)}
  />
</BaseLayout>

<style>
  .story,
  .values,
  .jobs {
    padding: var(--sp-section) var(--gutter);
  }

  .story__inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 4rem;
    align-items: start;
  }

  .story__title,
  .values__title,
  .jobs__title {
    font-size: var(--t-h2);
    line-height: 1.12;
  }

  .story__body {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    max-width: 42rem;
    color: var(--c-text-2);
    line-height: 1.7;
  }

  /* --- Criteri --- */

  .values {
    background: var(--c-page-alt);
  }

  .values__list {
    margin: 2.5rem 0 0;
  }

  .values__row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.375rem 0;
    border-top: 1px solid var(--c-line);
  }

  .values__row:last-child {
    border-bottom: 1px solid var(--c-line);
  }

  .values__term {
    font-family: var(--f-serif);
    font-size: 1.25rem;
    color: var(--c-text);
  }

  .values__detail {
    margin: 0;
    max-width: 46rem;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--c-text-2);
  }

  /* --- Posizioni --- */

  .jobs__lead {
    max-width: 42rem;
    margin: 1rem 0 2.5rem;
  }

  .jobs__row {
    display: grid;
    grid-template-columns: 1fr 1.2fr auto;
    gap: 1.5rem 2rem;
    align-items: baseline;
    padding: 1.5rem 0;
    border-top: 1px solid var(--c-line);
  }

  .jobs__list li:last-child {
    border-bottom: 1px solid var(--c-line);
  }

  .jobs__role {
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .jobs__detail {
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--c-text-2);
  }

  .jobs__note {
    margin-top: 1.75rem;
    font-size: var(--t-sm);
    color: var(--c-text-2);
  }

  @media (max-width: 1000px) {
    .story__inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .jobs__row {
      grid-template-columns: 1fr;
      gap: 0.625rem;
    }
  }

  @media (max-width: 680px) {
    .values__row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
