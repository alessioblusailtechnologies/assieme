---
import { getCollection, render } from 'astro:content';
import { spaziaturaFrancese as fr } from '~/i18n/fr/tipografia';
import { alternativeGuida, percorsoGuida } from '~/i18n/guide';
import GuidaLayout from '~/layouts/GuidaLayout.astro';

export async function getStaticPaths() {
  const guide = (await getCollection('guideFr')).filter((g) => !g.data.draft);
  return guide.map((g) => ({ params: { slug: g.id }, props: { guida: g, tutte: guide } }));
}

const { guida, tutte } = Astro.props;
const { Content } = await render(guida);

const altre = tutte
  .filter((g) => g.id !== guida.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3)
  .map((g) => ({
    title: fr(g.data.title),
    href: percorsoGuida(g.id, 'fr'),
    filone: g.data.filone,
  }));
---

<GuidaLayout
  lingua="fr"
  alternative={alternativeGuida(guida.id, 'fr', guida.data.gemella)}
  title={fr(guida.data.title)}
  description={fr(guida.data.description)}
  lead={fr(guida.data.lead)}
  filone={guida.data.filone}
  published={guida.data.published}
  updated={guida.data.updated}
  href={percorsoGuida(guida.id, 'fr')}
  altre={altre}
>
  <Content />
</GuidaLayout>
