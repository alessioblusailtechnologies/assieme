---
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import PageHero from '~/components/PageHero.astro';
import { FORM_ACCESS_KEY, FORM_ENDPOINT, SITE_URL, site } from '~/config/site';
import BaseLayout from '~/layouts/BaseLayout.astro';

const steps = [
  {
    term: '30 minuti',
    detail:
      'Una videochiamata in cui ci racconti come lavori oggi e ti mostriamo la piattaforma su un caso simile al tuo.',
  },
  {
    term: 'Un tuo documento',
    detail:
      'Se vuoi, portiamo un tuo capitolato, anche anonimizzato, e lo confrontiamo dal vivo. È il modo più rapido per capire se serve.',
  },
  {
    term: 'Nessun impegno',
    detail:
      'Nessuna installazione, nessun contratto da firmare per provare. Se non fa al caso tuo te lo diciamo noi.',
  },
];

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${SITE_URL}/demo#contactpage`,
  name: 'Richiedi una demo di Velia',
  inLanguage: 'it-IT',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#organization` },
};
---

<BaseLayout
  title="Richiedi una demo"
  description="Trenta minuti, un tuo capitolato e nessun impegno: prenota una demo di Velia e guarda la piattaforma lavorare sui documenti della tua agenzia."
  announcement={false}
  schema={[contactSchema]}
>
  <PageHero
    eyebrow="Demo"
    title="Portaci un capitolato, ti mostriamo il confronto"
    lead="Le demo generiche non convincono nessuno. Preferiamo lavorare su un documento vero: in mezz'ora capisci se Velia ti fa risparmiare tempo oppure no."
  />

  <Breadcrumbs trail={[{ label: 'Richiedi una demo', href: '/demo' }]} />

  <section class="demo" aria-labelledby="form-title">
    <div class="shell demo__inner">
      <div class="demo__aside">
        <h2 class="serif demo__title" id="form-title">Come funziona</h2>
        <dl class="demo__steps">
          {
            steps.map((s) => (
              <div class="demo__step">
                <dt class="demo__term">{s.term}</dt>
                <dd class="demo__detail">{s.detail}</dd>
              </div>
            ))
          }
        </dl>
        <p class="demo__contact">
          Preferisci scrivere? <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>

      <div class="demo__form-wrap">
        {
          !FORM_ENDPOINT && (
            <p class="demo__warning" role="note">
              <strong>Nota per chi pubblica il sito.</strong> La variabile
              d'ambiente <code>FORM_ENDPOINT</code> non è impostata: il modulo
              non invia da nessuna parte. Configurala prima della messa online.
            </p>
          )
        }

        <form
          class="form"
          method="post"
          action={FORM_ENDPOINT || undefined}
          novalidate
          data-demo-form
        >
          {/* Campi di servizio Web3Forms: destinazione, oggetto della mail
              e pagina di atterraggio dopo l'invio. */}
          <input type="hidden" name="access_key" value={FORM_ACCESS_KEY} />
          <input type="hidden" name="subject" value="Richiesta demo dal sito" />
          <input type="hidden" name="from_name" value="Sito Velia" />
          <input type="hidden" name="redirect" value={`${SITE_URL}/demo/grazie`} />
          <div class="form__row">
            <label class="form__field">
              <span class="form__label">Nome e cognome <abbr title="obbligatorio">*</abbr></span>
              <input
                type="text"
                name="nome"
                autocomplete="name"
                required
                minlength="2"
              />
            </label>

            <label class="form__field">
              <span class="form__label">Ruolo</span>
              <input type="text" name="ruolo" autocomplete="organization-title" />
            </label>
          </div>

          <div class="form__row">
            <label class="form__field">
              <span class="form__label">Organizzazione <abbr title="obbligatorio">*</abbr></span>
              <input
                type="text"
                name="organizzazione"
                autocomplete="organization"
                required
              />
            </label>

            <label class="form__field">
              <span class="form__label">Tipo di attività</span>
              <select name="tipo">
                <option value="">Seleziona…</option>
                <option>Agenzia</option>
                <option>Broker</option>
                <option>Intermediario</option>
                <option>Compagnia</option>
                <option>Altro</option>
              </select>
            </label>
          </div>

          <div class="form__row">
            <label class="form__field">
              <span class="form__label">E-mail di lavoro <abbr title="obbligatorio">*</abbr></span>
              <input type="email" name="email" autocomplete="email" required />
            </label>

            <label class="form__field">
              <span class="form__label">Telefono</span>
              <input type="tel" name="telefono" autocomplete="tel" />
            </label>
          </div>

          <label class="form__field">
            <span class="form__label">Che problema vorresti risolvere?</span>
            <textarea
              name="messaggio"
              rows="4"
              placeholder="Es. confrontiamo capitolati RC Professionale e ci vuole mezza giornata a posizione."
            ></textarea>
          </label>

          <label class="form__consent">
            <input type="checkbox" name="privacy" required />
            <span>
              Ho letto l'<a href="/legale/privacy">informativa privacy</a> e
              acconsento al trattamento dei miei dati per essere ricontattato.
              <abbr title="obbligatorio">*</abbr>
            </span>
          </label>

          {/* Trappola per i bot di Web3Forms: invisibile e fuori dall'ordine
              di tabulazione. Se arriva spuntata, il servizio scarta l'invio. */}
          <div class="form__trap" aria-hidden="true">
            <label>
              Non spuntare questa casella
              <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <button class="btn btn--accent btn--lg form__submit" type="submit">
            Richiedi una demo
          </button>

          <p class="form__note">
            Ti rispondiamo entro il giorno lavorativo successivo. I tuoi dati
            servono solo per ricontattarti e non vengono ceduti a terzi.
          </p>

          <p class="form__error" role="alert" hidden data-form-error></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .demo {
    padding: var(--sp-section) var(--gutter);
  }

  .demo__inner {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 4rem;
    align-items: start;
  }

  .demo__title {
    font-size: var(--t-h3);
    line-height: 1.15;
  }

  .demo__steps {
    margin: 2rem 0 0;
  }

  .demo__step {
    padding: 1.125rem 0;
    border-top: 1px solid var(--c-line);
  }

  .demo__step:last-child {
    border-bottom: 1px solid var(--c-line);
  }

  .demo__term {
    font-family: var(--f-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .demo__detail {
    margin: 0.5rem 0 0;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--c-text-2);
  }

  .demo__contact {
    margin-top: 1.5rem;
    font-size: var(--t-sm);
    color: var(--c-text-2);
  }

  .demo__warning {
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    font-size: var(--t-xs);
    line-height: 1.6;
    color: var(--c-neg);
    background: #f8eae6; /* il fondo negativo tenue della piattaforma */
    border: 1px solid #e8cfc8;
  }

  .demo__warning code {
    font-family: var(--f-mono);
    font-size: 0.75rem;
  }

  /* --- Modulo --- */

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
  }

  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form__field {
    display: flex;
    flex-direction: column;
    gap: 0.4375rem;
  }

  .form__label {
    font-family: var(--f-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-3);
  }

  .form__label abbr {
    color: var(--c-accent);
    text-decoration: none;
  }

  .form input[type='text'],
  .form input[type='email'],
  .form input[type='tel'],
  .form select,
  .form textarea {
    width: 100%;
    padding: 0.6875rem 0.75rem;
    font-size: var(--t-sm);
    color: var(--c-text);
    background: var(--c-page);
    border: 1px solid var(--c-line);
    border-radius: 0;
    transition: border-color var(--dur-fast) ease;
  }

  .form input:hover,
  .form select:hover,
  .form textarea:hover {
    border-color: var(--c-text-3);
  }

  .form input:focus-visible,
  .form select:focus-visible,
  .form textarea:focus-visible {
    border-color: var(--c-accent);
  }

  .form textarea {
    resize: vertical;
    min-height: 6rem;
    font-family: inherit;
  }

  .form :is(input, select, textarea)[aria-invalid='true'] {
    border-color: var(--c-neg);
  }

  .form__consent {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: var(--t-xs);
    line-height: 1.55;
    color: var(--c-text-2);
  }

  .form__consent input {
    margin-top: 0.2rem;
    accent-color: var(--c-accent);
    flex-shrink: 0;
  }

  .form__consent abbr {
    color: var(--c-accent);
    text-decoration: none;
  }

  .form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__submit {
    align-self: flex-start;
  }

  .form__note {
    font-size: var(--t-xs);
    line-height: 1.55;
    color: var(--c-text-4);
  }

  .form__error {
    padding: 0.75rem 1rem;
    font-size: var(--t-xs);
    color: var(--c-neg);
    border: 1px solid var(--c-neg);
  }

  .form__error[hidden] {
    display: none;
  }

  @media (max-width: 1000px) {
    .demo__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .form {
      padding: 1.5rem;
    }

    .form__row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  /*
   * Validazione lato client: il browser ha `novalidate`, così i messaggi sono
   * in italiano e coerenti, e i campi in errore ricevono aria-invalid.
   * La validazione vera resta comunque quella del destinatario.
   */
  const form = document.querySelector<HTMLFormElement>('[data-demo-form]');
  const errorBox = document.querySelector<HTMLElement>('[data-form-error]');

  if (form && errorBox) {
    const fields = () =>
      Array.from(
        form.querySelectorAll<
          HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
        >('input, select, textarea'),
      );

    const clear = (el: Element) => el.removeAttribute('aria-invalid');

    form.addEventListener('input', (event) => {
      const el = event.target;
      if (el instanceof HTMLElement) clear(el);
    });

    form.addEventListener('submit', (event) => {
      const invalid = fields().filter((el) => !el.checkValidity());

      fields().forEach(clear);
      invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));

      if (invalid.length > 0) {
        event.preventDefault();
        errorBox.textContent =
          invalid.length === 1
            ? 'Manca un campo obbligatorio, o il formato non è valido.'
            : `Ci sono ${invalid.length} campi da correggere.`;
        errorBox.hidden = false;
        invalid[0]?.focus();
        return;
      }

      errorBox.hidden = true;

      // Senza destinatario configurato il POST porterebbe a una pagina bianca:
      // meglio fermarsi e dirlo.
      if (!form.getAttribute('action')) {
        event.preventDefault();
        errorBox.textContent =
          'Invio non configurato su questo ambiente. Scrivi a ciao@sonovelia.it e ti rispondiamo subito.';
        errorBox.hidden = false;
      }
    });
  }
</script>
