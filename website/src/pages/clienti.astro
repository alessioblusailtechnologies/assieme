---
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Closing from '~/components/Closing.astro';
import PageHero from '~/components/PageHero.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { stats } from '~/data/home';

/**
 * Il prodotto è in fase pilota con una sola agenzia: questa pagina racconta
 * che cosa Assieme fa, non quanti lo usano. Le tre voci sono dimostrazioni
 * su documenti reali, non casi cliente — e la prima è il test case di
 * riferimento indicato nei requisiti (§5.3).
 */
const demos = [
  {
    id: 'confronto-auto',
    eyebrow: 'Ramo auto',
    title: 'Un preventivo concorrente smontato in dieci minuti',
    body: "Il cliente arriva con un preventivo di un'altra compagnia. Lo carichi, e Assieme lo mette accanto alle condizioni della polizza in corso — che sono già in archivio. Nove differenze che contano su cinquantaquattro garanzie, e per ognuna l'articolo da cui viene.",
    note: "È il caso su cui stiamo mettendo a punto la piattaforma con l'agenzia pilota.",
  },
  {
    id: 'tabella-analisi',
    eyebrow: 'Tabelle',
    title: 'Dieci prodotti a confronto in una tabella sola',
    body: 'Quando i documenti sono troppi per leggerli uno a uno, diventano una tabella: i prodotti in riga, i criteri in colonna. Dove il dato nel documento non c\'è, la casella dice "non presente" invece di indovinare.',
    note: 'La tabella si interroga a voce e si esporta in foglio di calcolo.',
  },
  {
    id: 'agente-edizioni',
    eyebrow: 'Agenti',
    title: 'Le nuove edizioni segnalate senza andarle a cercare',
    body: "«Avvisami quando esce una nuova edizione dei prodotti che colloco.» Lo scrivi una volta, scegli ogni quanto, e da lì in avanti te lo ritrovi fatto.",
    note: 'Vale lo stesso metodo della tua agenzia, e la fonte è citata comunque.',
  },
];
---

<BaseLayout
  title="Come si usa"
  description="Tre dimostrazioni su documenti reali: confronto fra set informativo e preventivo nel ramo auto, tabelle di analisi multi-prodotto e agenti pianificati."
>
  <PageHero
    eyebrow="Come si usa"
    title="Tre dimostrazioni, su documenti veri"
    lead="Assieme è in prova presso un'agenzia che lavora su documenti veri. Invece di raccontare risultati che non abbiamo ancora misurato, preferiamo far vedere che cosa fa."
  />

  <Breadcrumbs trail={[{ label: 'Come si usa', href: '/clienti' }]} />

  <section class="numbers" aria-labelledby="numbers-title">
    <div class="shell">
      <h2 class="serif numbers__title" id="numbers-title">
        I numeri della piattaforma
      </h2>
      <p class="lead numbers__lead">
        Non quanti lo usano — il prodotto non è ancora sul mercato — ma come è
        fatto. Ogni riga la puoi verificare in mezz'ora di demo.
      </p>
      {/* Nelle celle <dt> precede <dd> come vuole la specifica: l'ordine
          visivo — numero sopra, etichetta sotto — lo ribalta il CSS. */}
      <dl class="numbers__grid">
        {
          stats.map((s) => (
            <div class="numbers__item">
              <dt class="numbers__label">{s.label}</dt>
              <dd class="serif numbers__value">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="cases" aria-labelledby="cases-title">
    <div class="shell">
      <h2 class="serif cases__title" id="cases-title">Le dimostrazioni</h2>

      {
        demos.map((c) => (
          <article class="case" id={c.id} aria-labelledby={`${c.id}-title`}>
            <div class="case__media hatch" aria-hidden="true">
              <span class="mono">video · 16:9</span>
            </div>
            <div class="case__copy">
              <p class="mono case__eyebrow">{c.eyebrow}</p>
              <h3 class="serif case__heading" id={`${c.id}-title`}>
                {c.title}
              </h3>
              <p class="case__body">{c.body}</p>
              <p class="case__note">{c.note}</p>
              <a class="btn btn--text" href="/demo">
                Chiedi questa demo{' '}
                <span class="btn__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="pilot" aria-labelledby="pilot-title">
    <div class="shell pilot__inner">
      <h2 class="serif pilot__title" id="pilot-title">
        Cerchiamo agenzie con cui costruirlo
      </h2>
      <div class="pilot__copy">
        <p>
          Assieme è in lavorazione e lo stiamo mettendo a punto insieme a chi lo
          userà. Se ti va di provarlo su documenti tuoi e dirci dove sbaglia,
          per noi vale più di qualsiasi ricerca di mercato.
        </p>
        <a class="btn btn--outline" href="/demo">Candidati come pilota</a>
      </div>
    </div>
  </section>

  <Closing
    title="Vuoi vederlo su un tuo preventivo?"
    cta="Richiedi una demo"
  />
</BaseLayout>

<style>
  .numbers {
    padding: var(--sp-section) var(--gutter);
  }

  .numbers__title {
    font-size: var(--t-h2);
  }

  .numbers__lead {
    max-width: 42rem;
    margin: 1rem 0 2.5rem;
  }

  .numbers__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    margin: 0;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }

  .numbers__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.625rem;
    padding: 1.75rem 1.5rem;
    background: var(--c-page);
  }

  .numbers__value {
    margin: 0;
    font-size: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    line-height: 1;
    letter-spacing: var(--ls-tight);
    color: var(--c-text);
  }

  .numbers__label {
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--c-text-2);
  }

  .cases {
    padding: 0 var(--gutter) var(--sp-section);
  }

  .cases__title {
    font-size: var(--t-h2);
    margin-bottom: 3rem;
  }

  .case {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 3.5rem;
    align-items: start;
    padding: 3rem 0;
    border-top: 1px solid var(--c-line);
    scroll-margin-top: 2rem;
  }

  .case:last-child {
    border-bottom: 1px solid var(--c-line);
  }

  .case__media {
    display: flex;
    align-items: flex-end;
    aspect-ratio: 16 / 9;
    padding: 1rem;
    color: var(--c-text-4);
  }

  .case__copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .case__eyebrow {
    color: var(--c-accent);
  }

  .case__heading {
    font-size: var(--t-h3);
    line-height: 1.2;
  }

  .case__body {
    max-width: 42rem;
    color: var(--c-text-2);
    line-height: 1.65;
  }

  .case__note {
    max-width: 42rem;
    padding-left: 1rem;
    border-left: 2px solid var(--c-accent);
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--c-text-4);
  }

  .pilot {
    background: var(--c-page-alt);
    padding: var(--sp-section) var(--gutter);
  }

  .pilot__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .pilot__title {
    font-size: var(--t-h2);
    line-height: 1.12;
  }

  .pilot__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 38rem;
    color: var(--c-text-2);
    line-height: 1.7;
  }

  @media (max-width: 1000px) {
    .numbers__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .case,
    .pilot__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .case__media {
      max-width: 420px;
    }
  }

  @media (max-width: 560px) {
    .numbers__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
