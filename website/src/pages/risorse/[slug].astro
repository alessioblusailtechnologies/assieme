---
import { getCollection, render } from 'astro:content';
import GuidaLayout from '~/layouts/GuidaLayout.astro';

export async function getStaticPaths() {
  const guide = (await getCollection('guide')).filter((g) => !g.data.draft);
  return guide.map((g) => ({ params: { slug: g.id }, props: { guida: g, tutte: guide } }));
}

const { guida, tutte } = Astro.props;
const { Content } = await render(guida);

const altre = tutte
  .filter((g) => g.id !== guida.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3)
  .map((g) => ({ title: g.data.title, href: `/risorse/${g.id}`, filone: g.data.filone }));
---

<GuidaLayout
  title={guida.data.title}
  description={guida.data.description}
  lead={guida.data.lead}
  filone={guida.data.filone}
  published={guida.data.published}
  updated={guida.data.updated}
  href={`/risorse/${guida.id}`}
  altre={altre}
>
  <Content />
</GuidaLayout>
