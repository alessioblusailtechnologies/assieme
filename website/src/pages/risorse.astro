---
import { getCollection } from 'astro:content';
import Risorse from '~/views/Risorse.astro';

/* Le guide vivono in src/content/guide/it/, una pagina ciascuna in
   /risorse/<slug>; qui si elencano soltanto. */
const guide = (await getCollection('guide'))
  .filter((g) => !g.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .map((g) => ({
    id: g.id,
    titolo: g.data.title,
    descrizione: g.data.description,
    filone: g.data.filone,
  }));
---

<Risorse lingua="it" guide={guide} />
