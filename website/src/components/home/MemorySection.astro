---
import { contenuti, href, LINGUA_PREDEFINITA, type Lingua } from '~/i18n';

export interface Props {
  lingua?: Lingua;
}

const { lingua = LINGUA_PREDEFINITA } = Astro.props;
const t = contenuti(lingua).home;
const { memory } = t;
---

<section class="memory section--ink on-ink" aria-labelledby="memory-title">
  <div class="memory__inner shell">
    <div class="memory__figure">
      <canvas
        class="memory__canvas"
        width="1040"
        height="1000"
        role="img"
        aria-label={t.media.grafo}
        data-memory-graph></canvas>
    </div>

    <div class="memory__copy">
      <p class="eyebrow">{memory.eyebrow}</p>
      <h2 class="serif memory__title" id="memory-title">{memory.title}</h2>
      <p class="memory__body">{memory.body}</p>

      <dl class="memory__rows">
        {
          memory.rows.map((row) => (
            <div class="memory__row">
              <dt class="memory__term">{row.term}</dt>
              <dd class="memory__detail">{row.detail}</dd>
            </div>
          ))
        }
      </dl>

      <a class="btn btn--ghost" href={href(memory.link, lingua)}>
        {memory.cta}
      </a>
    </div>
  </div>
</section>

<style>
  .memory {
    background: var(--c-ink);
    padding: var(--sp-section) var(--gutter);
  }

  .memory__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4.5rem;
    align-items: center;
  }

  .memory__figure {
    display: flex;
    justify-content: center;
  }

  /* Il canvas ha risoluzione doppia rispetto alla resa: nitido su schermi
     ad alta densità senza dover ridisegnare al variare del DPR. */
  .memory__canvas {
    width: 100%;
    max-width: 520px;
    height: auto;
    aspect-ratio: 1040 / 1000;
  }

  .memory__copy {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .memory__title {
    font-size: var(--t-h2);
    line-height: 1.1;
    letter-spacing: -0.018em;
    color: var(--c-text-oninverse);
  }

  .memory__body {
    max-width: 32.5rem;
    line-height: 1.65;
    color: var(--c-text-oninverse-3);
  }

  .memory__rows {
    width: 100%;
    margin: 0;
  }

  .memory__row {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1rem 0;
    border-top: 1px solid var(--c-line-dark);
  }

  .memory__row:last-child {
    border-bottom: 1px solid var(--c-line-dark);
  }

  .memory__term {
    font-family: var(--f-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-accent-on-dark);
  }

  .memory__detail {
    margin: 0;
    font-size: var(--t-sm);
    line-height: 1.55;
    color: var(--c-text-oninverse-2);
  }

  @media (max-width: 1000px) {
    .memory__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .memory__figure {
      order: 2;
    }
  }

  @media (max-width: 560px) {
    .memory__row {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }
  }
</style>

<script>
  import { startGraph } from '~/scripts/memory-graph';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-memory-graph]');
  if (canvas) startGraph(canvas, { scale: 1 });
</script>
