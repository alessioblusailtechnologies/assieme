---
import { contenuti, href, LINGUA_PREDEFINITA, type Lingua } from '~/i18n';

export interface Props {
  lingua?: Lingua;
}

const { lingua = LINGUA_PREDEFINITA } = Astro.props;
const t = contenuti(lingua).home;
const t2 = t.testimonial;
---

{/* Non è una citazione: è la storia dell'agenzia pilota raccontata da noi,
    quindi niente blockquote né firma. */}
<section class="quote section--alt" aria-labelledby="quote-title">
  <h2 class="visually-hidden" id="quote-title">{t2.titolo}</h2>

  <div class="quote__inner shell">
    <img
      class="quote__portrait"
      src="/media/dal-campo.jpg"
      alt={t.media.ritratto}
      width="340"
      height="400"
      loading="lazy"
    />

    <div class="quote__figure">
      <p class="serif quote__text">{t2.quote}</p>
      <a class="btn btn--text" href={href(t2.link, lingua)}>
        {t2.cta} <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .quote {
    background: var(--c-page-alt);
    padding: var(--sp-section) var(--gutter);
  }

  .quote__inner {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 5rem;
    align-items: start;
  }

  .quote__portrait {
    display: block;
    width: 100%;
    height: 400px;
    object-fit: cover;
  }

  .quote__figure {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
    margin: 0;
    padding-top: 0.75rem;
  }

  .quote__text {
    margin: 0;
    max-width: 47.5rem;
    font-size: var(--t-h3);
    line-height: 1.34;
    letter-spacing: -0.012em;
    color: var(--c-text);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .quote__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .quote__portrait {
      max-width: 340px;
      height: 300px;
    }
  }
</style>
