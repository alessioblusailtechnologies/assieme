---
import { hero } from '~/data/home';

// La fascia loghi si riempie man mano che arrivano i marchi autorizzati;
// gli slot senza logo restano segnaposto tratteggiati.
const LOGO_SLOTS = 8;

/**
 * Interruttore dei loghi compagnia: i file sono in public/loghi/ e l'elenco
 * qui sotto è completo, ma mostrare marchi altrui in una fascia di riprova
 * sociale è una scelta da confermare (e da coprire con le autorizzazioni).
 * Con `false` la fascia mostra i segnaposto tratteggiati.
 */
const SHOW_COMPANY_LOGOS = false;

const logos: { src: string; alt: string }[] = [
  { src: '/loghi/unipol.svg', alt: 'Unipol' },
  { src: '/loghi/cattolica.svg', alt: 'Cattolica Assicurazioni' },
  { src: '/loghi/reale-mutua.png', alt: 'Reale Mutua' },
  { src: '/loghi/generali.svg', alt: 'Generali' },
  { src: '/loghi/allianz.svg', alt: 'Allianz' },
  { src: '/loghi/axa.svg', alt: 'AXA' },
  { src: '/loghi/zurich.svg', alt: 'Zurich' },
  { src: '/loghi/groupama.svg', alt: 'Groupama' },
];

const shownLogos = SHOW_COMPANY_LOGOS ? logos : [];
---

<section class="hero on-ink" aria-labelledby="hero-title">
  <div class="hero__stage">
    {/* Decorativo: il contenuto informativo sta tutto nel testo accanto. */}
    <video
      class="hero__video"
      src="/media/hero.mp4"
      poster="/media/hero-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      tabindex="-1"></video>

    <div class="hero__content">
      {/* Ogni riga in uno span, separato da uno spazio vero: così quando
          sui telefoni le righe tornano a scorrere insieme le parole non si
          incollano (con i <br> nascosti «agenzia.» ed «E» si toccavano). */}
      <h1 class="hero__title serif" id="hero-title">
        {
          hero.title.map((line, i) => (
            <Fragment>
              {i > 0 && ' '}<span class="hero__line">{line}</span>
            </Fragment>
          ))
        }
      </h1>
      <p class="hero__lead">{hero.lead}</p>
      <a class="btn btn--solid btn--lg hero__cta" href="/demo">
        Richiedi una demo
      </a>
    </div>
  </div>

  <div class="hero__proof">
    <ul class="hero__logos" aria-label="Clienti che usano Velia">
      {
        shownLogos.map((logo) => (
          <li class="hero__logo">
            <img
              class="hero__logo-img"
              src={logo.src}
              alt={logo.alt}
              loading="lazy"
            />
          </li>
        ))
      }
      {
        Array.from({ length: LOGO_SLOTS - shownLogos.length }, (_, i) => (
          <li class="hero__logo hatch">
            <span class="visually-hidden">Logo cliente {shownLogos.length + i + 1}</span>
            <span aria-hidden="true">logo</span>
          </li>
        ))
      }
    </ul>
    <a class="btn btn--outline btn--sm hero__proof-cta" href="/clienti">
      Guarda Velia al lavoro
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--c-ink);
  }

  /* Sfondo a tre strati: il video in fondo, il tratteggio come riserva
     mentre carica (o quando è spento), il gradiente sopra a garantire il
     contrasto del testo. */
  .hero__stage {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 620px;
    /* Il margine laterale sta qui, non su .hero__content: quest'ultimo deve
       poter usare i suoi 720px interi per il testo (vedi sotto). */
    padding: 4rem var(--gutter);
    background: repeating-linear-gradient(135deg, #24221c 0 10px, #2e2b24 10px 20px);
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ::after e non ::before: viene dopo il video nell'ordine di pittura,
     quindi il gradiente gli resta sopra senza bisogno di z-index. */
  .hero__stage::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #1c1a15 0%,
      rgb(28 26 21 / 92%) 42%,
      rgb(28 26 21 / 55%) 70%,
      rgb(28 26 21 / 45%) 100%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }

  /* 720px come nel design: il margine laterale sta su .hero__stage, così il
     testo dispone dei 720px interi (vedi sopra). */
  .hero__content {
    position: relative; /* sopra il gradiente in ::after */
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    align-items: flex-start;
    max-width: 45rem;
  }

  /*
   * Corpo ridotto rispetto al token display (44→84px): la riga più lunga del
   * titolo — «come lavora la tua agenzia.» — misura 11,55em (metrici TWK
   * Ghost Regular, tracking −0.02em compreso), quindi oltre 62px il box da
   * 720px non la contiene e il browser aggiungerebbe una quarta riga. Il
   * massimo sta a 3.8rem con un 2% di margine; la pendenza tiene la riga
   * dentro (100vw − 2×gutter) a ogni larghezza intermedia. Sotto i 640px le
   * tre righe forzate imporrebbero corpi da h3: lì gli a-capo manuali si
   * spengono e il testo scorre naturale (vedi media query in fondo).
   */
  .hero__title {
    font-size: clamp(1.5rem, 0.6rem + 3.9vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: var(--ls-tight);
    color: var(--c-text-oninverse);
    text-wrap: initial; /* le tre righe sono decise a mano */
  }

  .hero__line {
    display: block;
  }

  .hero__lead {
    max-width: 28.75rem;
    font-size: var(--t-lead);
    line-height: 1.6;
    color: var(--c-text-oninverse-2);
  }

  /* --- Fascia di riprova sociale --- */

  /* Fascia chiara sotto la hero scura: i loghi delle compagnie sono a
     colori pieni e sul fondo scuro non si leggerebbero. Il colore è quello
     della pagina, così la fascia scorre nella sezione che segue. */
  .hero__proof {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 74px;
    padding: 1rem var(--gutter);
    background: var(--c-page);
    border-bottom: 1px solid var(--c-line);
  }

  .hero__logos {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 1.25rem;
  }

  .hero__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    font-family: var(--f-mono);
    font-size: 0.5625rem;
    color: var(--c-text-oninverse-hatch);
  }

  .hero__logo-img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }

  .hero__proof-cta {
    flex-shrink: 0;
  }

  @media (max-width: 1080px) {
    .hero__stage {
      min-height: 32rem;
    }

    .hero__logos {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
  }

  @media (max-width: 640px) {
    /* Sui telefoni le prime due righe tornano a scorrere insieme, con un
       corpo leggibile; solo «E non lo dimentica.» tiene il suo a-capo,
       perché è la chiusura e deve iniziare da sola. */
    .hero__line {
      display: inline;
    }

    .hero__line:last-child {
      display: block;
    }

    .hero__title {
      font-size: 2rem;
      text-wrap: balance;
    }

    .hero__stage {
      min-height: 26rem;
    }

    /* Sullo schermo stretto il testo copre tutta la larghezza: il velo
       scuro si stende uniforme sull'intero video. */
    .hero__stage::after {
      background: linear-gradient(90deg, #1c1a15 0%, rgb(28 26 21 / 82%) 100%);
    }

    .hero__proof {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding-block: 1.5rem;
    }

    .hero__logos {
      grid-template-columns: repeat(3, 1fr);
    }

    .hero__proof-cta {
      align-self: flex-start;
    }
  }
</style>
