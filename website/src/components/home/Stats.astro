---
import { contenuti, LINGUA_PREDEFINITA, type Lingua } from '~/i18n';

export interface Props {
  lingua?: Lingua;
}

const { lingua = LINGUA_PREDEFINITA } = Astro.props;
const t = contenuti(lingua).home;
const { stats, statsIntro } = t;
---

<section class="stats" aria-labelledby="stats-title">
  <div class="stats__head">
    <h2 class="stats__title" id="stats-title">
      {statsIntro[0]}<br />{statsIntro[1]}
    </h2>
  </div>

  <dl class="stats__list">
    {
      stats.map((s) => (
        <div class="stats__row">
          <dt class="stats__label">{s.label}</dt>
          <dd class="serif stats__value">{s.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .stats {
    padding-top: var(--sp-section);
  }

  .stats__head {
    display: flex;
    justify-content: flex-end;
    padding-inline: var(--gutter);
  }

  .stats__title {
    width: 52%;
    font-family: var(--f-sans);
    font-size: clamp(1.125rem, 0.85rem + 1.1vw, 1.375rem);
    font-weight: 400;
    line-height: 1.4;
    color: var(--c-text-oninverse);
    text-wrap: initial;
  }

  .stats__list {
    margin: 3rem 0 0;
    padding-inline: var(--gutter);
  }

  .stats__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 1.5rem;
    padding: 1.625rem 0;
    border-top: 1px solid var(--c-line-dark);
  }

  .stats__row:last-child {
    border-bottom: 1px solid var(--c-line-dark);
  }

  .stats__label {
    font-size: var(--t-sm);
    color: var(--c-text-oninverse-2);
  }

  .stats__value {
    margin: 0;
    font-size: var(--t-stat);
    line-height: 1;
    letter-spacing: var(--ls-tight);
    color: var(--c-text-oninverse);
  }

  @media (max-width: 900px) {
    .stats__title {
      width: 100%;
    }

    .stats__head {
      justify-content: flex-start;
    }
  }

  @media (max-width: 560px) {
    .stats__row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
