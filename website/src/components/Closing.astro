---
import CtaBanner from './CtaBanner.astro';

export interface Props {
  title?: string;
  cta?: string;
  href?: string;
}

// Chiusura scura che si salda al piè di pagina, come nella homepage.
---

<div class="closing section--ink on-ink">
  <CtaBanner {...Astro.props} />
</div>

<style>
  .closing {
    background: var(--c-ink);
    color: var(--c-text-oninverse);
  }

  /* Il bordo superiore lo porta già CtaBanner: qui servirebbe solo a
     raddoppiarlo. */
  .closing :global(.cta) {
    border-top: 0;
    padding-block: clamp(2.5rem, 1.6rem + 3.6vw, 4rem);
  }
</style>
