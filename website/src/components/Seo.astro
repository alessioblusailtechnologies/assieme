---
import { SITE_URL, site } from '~/config/site';
import {
  alternative as alternativeDiRotta,
  contenuti,
  LINGUA_PREDEFINITA,
  lingue,
  type Alternativa,
  type Lingua,
} from '~/i18n';
import { cleanPath } from '~/utils/url';

export interface Props {
  title: string;
  description: string;
  /** Sovrascrive il canonical calcolato dall'URL corrente. */
  canonical?: string;
  /** Immagine di anteprima, relativa alla radice del sito. */
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  /** Esclude la pagina dall'indice (404, pagine di servizio). */
  noindex?: boolean;
  /** Blocchi JSON-LD aggiuntivi rispetto a quelli globali. */
  schema?: Record<string, unknown>[];
  lingua?: Lingua;
  /** Alternate espliciti per le rotte fuori tabella, come le guide. */
  alternative?: Alternativa[];
}

const {
  title,
  description,
  canonical,
  image = '/og/velia-default.png',
  imageAlt,
  ogType = 'website',
  noindex = false,
  schema = [],
  lingua = LINGUA_PREDEFINITA,
  alternative,
} = Astro.props;

const t = contenuti(lingua).seo;
const scheda = lingue[lingua];

/*
 * `build.format: 'file'` genera /piattaforma.html, e in fase di build
 * `Astro.url.pathname` riporta proprio quel nome di file. Lasciato così, il
 * canonical punterebbe a /piattaforma.html mentre la sitemap dichiara
 * /piattaforma: due URL per la stessa pagina, che è esattamente il problema
 * che il canonical dovrebbe risolvere. Qui si torna all'URL pulito.
 */
const pathname = cleanPath(Astro.url.pathname);

/*
 * Il canonical di una pagina punta sempre a sé stessa, anche in francese.
 * Canonicalizzare una traduzione sull'originale la toglie dall'indice, ed è
 * l'errore che manda in fumo tutto il lavoro di un sito multilingua.
 */
const canonicalUrl = canonical ?? new URL(pathname, SITE_URL).href;
const imageUrl = new URL(image, SITE_URL).href;

const fullTitle = pathname === '/' ? title : `${title} | ${site.name}`;

/*
 * Gli alternate arrivano dalla tabella delle rotte, o espliciti per le rotte
 * dinamiche. Includono sempre l'autoriferimento: un hreflang che non nomina
 * anche sé stesso viene scartato in blocco, e vale come non averlo messo.
 * Quando la pagina esiste in una lingua sola la lista è vuota e non si emette
 * nulla: un alternate non ricambiato è peggio di nessun alternate.
 */
const alternate = alternative ?? alternativeDiRotta(pathname);
const altre = alternate.filter((a) => a.lingua !== lingua);

/* ---------------------------------------------------------------------------
 * Dati strutturati globali: presenti su ogni pagina, così che l'entità
 * Organization sia consistente ovunque il crawler entri.
 * ------------------------------------------------------------------------ */

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: site.name,
  // I nomi con cui la gente cerca e con cui il marchio si presenta sui
  // social: aiutano a distinguere Velia dall'omonima città antica.
  alternateName: t.organizzazione.alternateName,
  legalName: site.legalName,
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/og/velia-logo.png', SITE_URL).href,
    width: 512,
    height: 512,
  },
  description: t.organizzazione.description,
  foundingDate: String(site.foundingYear),
  email: site.email,
  // Indirizzo completo volutamente assente: meglio nessun dato che uno
  // inventato in un blocco che i motori trattano come dichiarazione.
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressCountry: site.country,
  },
  areaServed: { '@type': 'Country', name: t.organizzazione.areaServita },
  sameAs: [site.social.linkedin, site.social.facebook, site.social.instagram],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: site.name,
  alternateName: 'Sono Velia',
  url: SITE_URL,
  inLanguage: scheda.hreflang,
  publisher: { '@id': `${SITE_URL}/#organization` },
};

const jsonLd = [organizationSchema, websiteSchema, ...schema];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{
  alternate.map((a) => (
    <link
      rel="alternate"
      hreflang={lingue[a.lingua].hreflang}
      href={new URL(a.href, SITE_URL).href}
    />
  ))
}
{
  /* x-default va alla lingua predefinita: è la versione servita a chi non
     rientra in nessuna delle altre. */
  alternate.length > 0 && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={
        new URL(
          alternate.find((a) => a.lingua === LINGUA_PREDEFINITA)?.href ??
            alternate[0]!.href,
          SITE_URL,
        ).href
      }
    />
  )
}

{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={scheda.ogLocale} />
{altre.map((a) => <meta property="og:locale:alternate" content={lingue[a.lingua].ogLocale} />)}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt ?? t.immagineAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt ?? t.immagineAlt} />

<!-- Dati strutturati -->
{
  jsonLd.map((node) => (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(node)}
    />
  ))
}
