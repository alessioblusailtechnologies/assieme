---
import { SITE_URL, site } from '~/config/site';
import { cleanPath } from '~/utils/url';

export interface Props {
  title: string;
  description: string;
  /** Sovrascrive il canonical calcolato dall'URL corrente. */
  canonical?: string;
  /** Immagine di anteprima, relativa alla radice del sito. */
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  /** Esclude la pagina dall'indice (404, pagine di servizio). */
  noindex?: boolean;
  /** Blocchi JSON-LD aggiuntivi rispetto a quelli globali. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  image = '/og/velia-default.png',
  imageAlt = 'Velia, la piattaforma AI per la distribuzione assicurativa',
  ogType = 'website',
  noindex = false,
  schema = [],
} = Astro.props;

/*
 * `build.format: 'file'` genera /piattaforma.html, e in fase di build
 * `Astro.url.pathname` riporta proprio quel nome di file. Lasciato così, il
 * canonical punterebbe a /piattaforma.html mentre la sitemap dichiara
 * /piattaforma: due URL per la stessa pagina, che è esattamente il problema
 * che il canonical dovrebbe risolvere. Qui si torna all'URL pulito.
 */
const pathname = cleanPath(Astro.url.pathname);
const canonicalUrl = canonical ?? new URL(pathname, SITE_URL).href;
const imageUrl = new URL(image, SITE_URL).href;

const fullTitle =
  pathname === '/' ? title : `${title} | ${site.name}`;

/* ---------------------------------------------------------------------------
 * Dati strutturati globali: presenti su ogni pagina, così che l'entità
 * Organization sia consistente ovunque il crawler entri.
 * ------------------------------------------------------------------------ */

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: site.name,
  legalName: site.legalName,
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/og/velia-logo.png', SITE_URL).href,
    width: 512,
    height: 512,
  },
  description:
    'Velia è l’assistente AI per agenzie assicurative, broker e intermediari: un archivio di set informativi già pronto, i documenti dell’agenzia accanto ai loro e ogni risposta con la citazione al passaggio di origine.',
  foundingDate: String(site.foundingYear),
  email: site.email,
  // Indirizzo completo volutamente assente: meglio nessun dato che uno
  // inventato in un blocco che i motori trattano come dichiarazione.
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressCountry: site.country,
  },
  areaServed: { '@type': 'Country', name: 'Italia' },
  sameAs: [
    site.social.linkedin,
    site.social.facebook,
    site.social.instagram,
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: site.name,
  url: SITE_URL,
  inLanguage: 'it-IT',
  publisher: { '@id': `${SITE_URL}/#organization` },
};

const jsonLd = [organizationSchema, websiteSchema, ...schema];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Dati strutturati -->
{
  jsonLd.map((node) => (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(node)}
    />
  ))
}
