---
export interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  cta?: { label: string; href: string };
}

const { eyebrow, title, lead, cta } = Astro.props;
---

<section class="page-hero on-ink" aria-labelledby="page-title">
  <div class="page-hero__inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="serif page-hero__title" id="page-title">{title}</h1>
    {lead && <p class="page-hero__lead">{lead}</p>}
    {
      cta && (
        <a class="btn btn--solid btn--lg page-hero__cta" href={cta.href}>
          {cta.label}
        </a>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    background:
      linear-gradient(90deg, #14181d 0%, rgb(20 24 29 / 88%) 100%),
      repeating-linear-gradient(135deg, #1b2027 0 10px, #20262e 10px 20px);
    padding: clamp(3.5rem, 1.6rem + 7.6vw, 7rem) var(--gutter);
  }

  .page-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: var(--shell);
    margin-inline: auto;
  }

  .page-hero__title {
    max-width: 20ch;
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 4rem);
    line-height: 1.05;
    letter-spacing: var(--ls-tight);
    color: var(--c-text-oninverse);
  }

  .page-hero__lead {
    max-width: 40rem;
    font-size: var(--t-lead);
    line-height: 1.6;
    color: var(--c-text-oninverse-2);
  }

  .page-hero__cta {
    margin-top: 0.5rem;
  }
</style>
