#!/bin/sh
# Claude Code come utente `lavoro`, dentro il namespace di rete isolato: è
# ciò che l'SDK lancia al posto del binario (pathToClaudeCodeExecutable).
# setpriv cambia utente ed esegue direttamente: argomenti e ambiente passano
# intatti (base URL del proxy, HOME, PATH). Con la rete aperta (Render,
# SANDBOX_NETNS=0) resta il cambio di utente, senza il namespace.
if [ "${SANDBOX_NETNS:-1}" = "1" ]; then
  exec ip netns exec lavoro setpriv --reuid=lavoro --regid=lavoro --init-groups \
    /opt/sandbox/node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude "$@"
else
  exec setpriv --reuid=lavoro --regid=lavoro --init-groups \
    /opt/sandbox/node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude "$@"
fi
