# Puntamenti del progetto Supabase online — copiare in .env e compilare.
# .env NON va mai committato (è in .gitignore).

# Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Solo worker e job di sistema: scavalca la RLS. Trattarla come una password.
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard → Project Settings → Database → Connection string (URI).
# Per il worker serve una connessione a sessione (diretta o pooler in
# modalità session, porta 5432): LISTEN/NOTIFY non passa dal transaction pooler.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Per la CLI (supabase link / db push): token da https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Conversione e classificazione documenti (Haiku) e motore agentico (Agent SDK), dal worker; l'API pura ne fa a meno.
ANTHROPIC_API_KEY=
# Motore agentico (Fase 3): modello e budget per job — decisioni aperte 1 e 4 del doc motore, si misurano, non si cablano.
MODELLO_MOTORE=claude-opus-5
MOTORE_MAX_TURNI=40
MOTORE_BUDGET_USD=3
# MOTORE_EFFORT=high
# Estrazione celle delle tabelle (Fase 5): di default lo stesso del motore, si abbassa coi numeri di `consumi`.
# MODELLO_TABELLE=claude-sonnet-5
# Dove il worker materializza workspace e cache dei documenti (relativo a be-node/).
CARTELLA_WORKER=.velia-worker

PORTA_API=3002
LOG_LIVELLO=info

# Modelli open in datacenter UE via HostYourAI (API Anthropic-compatibili):
# con la chiave, GLM 5.2 e Kimi K3 diventano selezionabili nelle Impostazioni.
# HOSTYOURAI_API_KEY=hyai-...
# HOSTYOURAI_BASE_URL=https://hostyourai.com
