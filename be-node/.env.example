# Puntamenti del progetto Supabase online — copiare in .env e compilare.
# .env NON va mai committato (è in .gitignore).

# Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Solo worker e job di sistema: scavalca la RLS. Trattarla come una password.
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard → Project Settings → Database → Connection string (URI).
# Per il worker serve una connessione a sessione (diretta o pooler in
# modalità session, porta 5432): LISTEN/NOTIFY non passa dal transaction pooler.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Per la CLI (supabase link / db push): token da https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Conversione e classificazione documenti (Haiku) e motore agentico (Agent SDK), dal worker; l'API pura ne fa a meno.
ANTHROPIC_API_KEY=
# Motore agentico (Fase 3): modello e budget per job — decisioni aperte 1 e 4 del doc motore, si misurano, non si cablano.
MODELLO_MOTORE=claude-opus-5
MOTORE_MAX_TURNI=40
MOTORE_BUDGET_USD=3
# MOTORE_EFFORT=high
# Ripresa della sessione SDK fra un messaggio e l'altro (follow-up a -76% di costo); `no` = job pieno a ogni messaggio.
# MOTORE_RIPRESA=si
# Estrazione celle delle tabelle (Fase 5): di default lo stesso del motore, si abbassa coi numeri di `consumi`.
# MODELLO_TABELLE=claude-sonnet-5
# Estrazione dei ricordi (Fase 8): gira dopo ogni risposta, fisso e non segue il modello del tenant.
# MODELLO_MEMORIA=claude-sonnet-5
# Saluti della schermata iniziale: un lotto di frasi per fascia oraria, rigenerato dall'API quando è più vecchio di SALUTI_ORE_VALIDITA.
# MODELLO_SALUTI=claude-opus-5
# SALUTI_ORE_VALIDITA=24
# SALUTI_GENERAZIONE=si   (`no` = restano le frasi fisse del FE)
# Suggerimenti della home: domande di partenza sul contesto dell'agenzia, un lotto per utente rigenerato dall'API quando scaduto o quando l'archivio cambia.
# MODELLO_SUGGERIMENTI=claude-sonnet-5
# SUGGERIMENTI_ORE_VALIDITA=24
# SUGGERIMENTI_GENERAZIONE=si   (`no` = restano gli esempi del FE)
# Dove il worker materializza workspace e cache dei documenti (relativo a be-node/).
CARTELLA_WORKER=.velia-worker

PORTA_API=3002
LOG_LIVELLO=info

# Modelli open in datacenter UE via HostYourAI (API Anthropic-compatibili):
# con la chiave, GLM 5.2 e Kimi K3 diventano selezionabili nelle Impostazioni.
# HOSTYOURAI_API_KEY=hyai-...
# HOSTYOURAI_BASE_URL=https://hostyourai.com

# App e API su host diversi (Cloudflare Pages + Railway): origini ammesse, separate da virgola.
# CORS_ORIGINI=https://app.sonovelia.it
# La porta la assegna la piattaforma in PORT; in locale resta PORTA_API=3002.

# Silenzio massimo del modello prima di chiudere la sessione con errore (ms). Default 180000.
# MOTORE_SILENZIO_MS=180000

# «Invia email» sotto una risposta: Resend via HTTP. Senza chiave, in locale l'email finisce nel log (invio simulato);
# in produzione l'invio risponde 503. Il mittente va verificato su Resend.
# RESEND_API_KEY=re_...
# EMAIL_MITTENTE=Velia <noreply@sonovelia.it>

# Dettatura nel composer: Voxtral di Mistral (console.mistral.ai). Senza chiave il microfono dice che non è configurato.
# MISTRAL_API_KEY=...
# MODELLO_TRASCRIZIONE=voxtral-mini-latest

# --- Esportazione elaborata: la sandbox documentale ---------------------------
# `docker` in locale (immagine da `docker build -t velia-sandbox -f sandbox/Dockerfile sandbox`),
# `fly` in produzione (una Machine Fly.io per job, immagine sul registry di Fly). Vuoto = non disponibile.
SANDBOX_AVVIATORE=docker
SANDBOX_IMMAGINE=velia-sandbox
# SANDBOX_MAX_TURNI=60
# SANDBOX_BUDGET_USD=4
# La chiave Anthropic che entra nella sandbox (dedicata, con tetto di spesa); senza, vale ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY_SANDBOX=
# Per `fly`: token di organizzazione, app che ospita le Machine, regione.
# FLY_API_TOKEN=
# FLY_APP_SANDBOX=velia-sandbox
# FLY_REGIONE=ams
# SANDBOX_IMMAGINE=registry.fly.io/velia-sandbox:latest
