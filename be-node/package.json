{
  "name": "velia-be",
  "version": "0.0.1",
  "private": true,
  "description": "VELIA — backend (API Fastify + worker). Vedi VELIA-piano-sviluppo-be.md",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/db/tipi-generati.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/multipart": "^9.4.0",
    "@supabase/supabase-js": "^2.112.2",
    "fastify": "^5.11.2",
    "jose": "^6.2.8",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "supabase": "^2.111.0",
    "tsx": "^4.23.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
